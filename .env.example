# Set ONE of these keys. With no key, the app uses the keyword fallback classifier.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: force a provider (anthropic | openai | gemini) and/or model.
# Defaults: anthropic=claude-haiku-5-5, openai=gpt-4o-mini, gemini=gemini-2.5-flash
LLM_PROVIDER=
LLM_MODEL=
